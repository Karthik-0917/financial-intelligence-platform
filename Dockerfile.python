FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY pyproject.toml ./
COPY core ./core
COPY ai_service ./ai_service
COPY backend ./backend
COPY ingestion ./ingestion
COPY evaluation ./evaluation
COPY configs ./configs

RUN python -m pip install --no-cache-dir . \
    && useradd --create-home --uid 10001 app \
    && mkdir -p /app/data/processed /app/indexes /app/evaluation/results \
    && chown -R app:app /app

FROM base AS backend

USER app

EXPOSE 8000

CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]

FROM base AS ai-service

RUN python -m pip install --no-cache-dir "torch>=2.6,<3" \
        --index-url https://download.pytorch.org/whl/cpu \
    && python -m pip install --no-cache-dir ".[ml]"

USER app

EXPOSE 8001

CMD ["uvicorn", "ai_service.main:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1"]